# Copy to .env and fill in real values. Never commit .env.
# Variable names follow freelancer_communication_assistant_docs/07-engineering/DEPLOYMENT.md
APP_ENV=development
APP_SECRET_KEY=
DATABASE_URL=sqlite:///./saylient.db
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
# The deployed frontend (Vercel) calls this API (Render) cross-site, so
# production needs: SESSION_COOKIE_SECURE=true and
# SESSION_COOKIE_SAMESITE=none (browsers reject SameSite=None without
# Secure). Local dev keeps lax + insecure.
APP_ORIGIN=http://127.0.0.1:5173
# Password-reset email (SMTP). All optional — without SMTP_HOST no email
# is sent; in production forgot-password then answers honestly that
# reset by email is not set up (it never claims a link was sent).
# Set these in the deployment environment (Render env vars), never here.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Saylient AI <noreply@saylient.ai>
SMTP_USE_TLS=true
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
