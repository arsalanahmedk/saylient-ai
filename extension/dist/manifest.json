{
  "manifest_version": 3,
  "name": "Saylient AI — Communication Assistant",
  "version": "0.1.0",
  "description": "Analyze a message from the Saylient AI demo workspace and get a clearer draft — only when you click Analyze.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://saylient-ai.vercel.app/*",
    "https://saylient-ai-backend.onrender.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content.css"
      ],
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://saylient-ai.vercel.app/*"
      ]
    }
  ],
  "action": {
    "default_title": "Open Saylient AI",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://saylient-ai.vercel.app/*"
      ],
      "js": [
        "config.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon.svg",
    "48": "icon.svg",
    "128": "icon.svg"
  }
}